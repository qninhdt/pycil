# The sole public ingress. Caddy provisions HTTPS automatically for a real
# DOMAIN and uses its local CA for localhost development.
{$DOMAIN:localhost} {
	# Conversation turns stream AG-UI events without compression or buffering.
	@assistant_sse path /v1/assistant:run
	@non_sse not path /v1/assistant:run
	encode @non_sse zstd gzip
	@api path /v1/* /livez /readyz /openapi.json /docs* /redoc*
	# Exact byte cap mirrors config/config.yaml for both streaming and JSON routes.
	request_body @api {
		max_size 15000000
	}

	handle @assistant_sse {
		header {
			Cache-Control "no-cache"
			X-Accel-Buffering "no"
		}
		reverse_proxy api:8000 {
			# text/event-stream flushes immediately by default; retain cancellation.
			transport http {
				compression off
				response_header_timeout 3m
			}
		}
	}

	handle @api {
		reverse_proxy api:8000
	}

	# This repository serves the API only. Everything else is 404.
	handle {
		respond "Not Found" 404
	}
}
