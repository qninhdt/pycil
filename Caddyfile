# The sole public ingress. Caddy provisions HTTPS automatically for a real
# DOMAIN and uses its local CA for localhost development.
{$DOMAIN:localhost} {
	# The assistant route streams `text/event-stream`. `/v1/assistant` is the browser's
	# chat transport; leaving it out would let the edge compress and buffer a stream,
	# which arrives as one blob after the turn ends instead of incrementally.
	@assistant_sse path /v1/assistant
	@non_sse not path /v1/assistant
	encode @non_sse zstd gzip

	handle @assistant_sse {
		header {
			Cache-Control "no-cache"
			X-Accel-Buffering "no"
		}
		reverse_proxy api:8000 {
			flush_interval -1
			transport http {
				response_header_timeout 3m
			}
		}
	}

	@api path /v1/* /health /health/* /openapi.json /docs* /redoc*
	handle @api {
		# Mirrors the API's cumulative streaming request-body cap at the edge.
		request_body {
			max_size 1MB
		}
		reverse_proxy api:8000
	}

	# The Next.js web app is hosted independently on Vercel. Everything else is 404.
	handle {
		respond "Not Found" 404
	}
}
