# The sole public ingress. Caddy provisions HTTPS automatically for a real
# DOMAIN and uses its local CA for localhost development.
{$DOMAIN:localhost} {
	# Both assistant routes stream `text/event-stream`. `/ag-ui` is the browser's
	# chat transport and `/threads/{id}/runs/stream` is the plain-message variant;
	# leaving either out would let the edge compress and buffer a stream, which
	# arrives as one blob after the turn ends instead of incrementally.
	@assistant_sse path /v1/assistant/ag-ui /v1/assistant/threads/*/runs/stream
	@non_sse not path /v1/assistant/ag-ui /v1/assistant/threads/*/runs/stream
	encode @non_sse zstd gzip

	handle @assistant_sse {
		header {
			Cache-Control "no-cache"
			X-Accel-Buffering "no"
		}
		reverse_proxy api:8000 {
			flush_interval -1
			transport http {
				response_header_timeout 3m
			}
		}
	}

	@api path /v1/* /health /health/* /openapi.json /docs* /redoc*
	handle @api {
		# Mirrors the API's cumulative streaming request-body cap at the edge.
		request_body {
			max_size 1MB
		}
		reverse_proxy api:8000
	}

	# Everything else is the Next app. This has to be last: it is the catch-all,
	# so any matcher placed after it would never be reached.
	handle {
		reverse_proxy web:3000
	}
}
