# The sole public ingress. Caddy provisions HTTPS automatically for a real
# DOMAIN and uses its local CA for localhost development.
{$DOMAIN:localhost} {
	# Conversation turns stream AG-UI events without compression or buffering.
	@assistant_sse path /v1/assistant/conversations/*/turns
	@non_sse not path /v1/assistant/conversations/*/turns
	encode @non_sse zstd gzip

	handle @assistant_sse {
		header {
			Cache-Control "no-cache"
			X-Accel-Buffering "no"
		}
		reverse_proxy api:8000 {
			flush_interval -1
			transport http {
				response_header_timeout 3m
			}
		}
	}

	@api path /v1/* /health /ready /openapi.json /docs* /redoc*
	handle @api {
		# Mirrors the API's cumulative streaming request-body cap at the edge.
		request_body {
			max_size 1MB
		}
		reverse_proxy api:8000
	}

	# This repository serves the API only. Everything else is 404.
	handle {
		respond "Not Found" 404
	}
}
