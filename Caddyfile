# The sole public ingress. Caddy provisions HTTPS automatically for a real
# DOMAIN and uses its local CA for localhost development.
{$DOMAIN:localhost} {
	# SSE must not be compressed or buffered: each Centrifugo publication needs
	# to reach the browser immediately for recovery to converge.
	@non_sse not path /connection/sse* /emulation*
	encode @non_sse zstd gzip

	@api path /v1/* /health /health/* /openapi.json /docs* /redoc*
	handle @api {
		# Mirrors the API's cumulative streaming request-body cap at the edge.
		request_body {
			max_size 1MB
		}
		reverse_proxy api:8000
	}

	# Centrifugo exposes only SSE plus its HTTP command emulation endpoint. The
	# subscribe proxy remains container-internal at /internal/realtime/subscribe.
	@centrifugo path /connection/sse* /emulation*
	handle @centrifugo {
		header {
			Cache-Control "no-cache"
			X-Accel-Buffering "no"
		}
		reverse_proxy centrifugo:8000 {
			flush_interval -1
		}
	}

	handle {
		respond "not found" 404
	}
}
