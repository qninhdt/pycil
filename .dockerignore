# ─────────────────────────────────────────────────────────────
# Pycil Docker Build Ignore
# Build context is repo root, targeting apps/api/Dockerfile.
# Exclude everything not needed by the backend Python service.
# ─────────────────────────────────────────────────────────────

# Version control & CI
.git
.github

# Exclude web frontend, e2e, and courses (not needed in API image)
apps/web
tests
devops-course

# Documentation & planning scratch
docs
plans
*.md

# Large data files (mounted at runtime via volume / bind mount)
data

# Python build artifacts & caches
**/__pycache__
**/*.py[cod]
**/*.egg-info
**/.pytest_cache
**/.ruff_cache
**/.mypy_cache
**/.coverage
**/coverage
apps/api/tests

# Virtual environments
**/.venv
**/venv
**/env

# Node.js artifacts & caches
**/node_modules
**/.next
**/storybook-static
**/tsconfig.tsbuildinfo
**/.turbo
**/build
**/dist
**/out

# Secrets & Local Environment
**/.env
**/.env.*
**/.env.local
!**/.env.example

# Local databases & dumps
*.dump
*.sql
*.sql.gz
backup-manifest-*.json

# Agent & editor scratch
.agents
.agent
.codegraph
.codex
.impeccable
.claude
.gemini
.vscode
.idea
*.log
logs
