# =============================================================================
# Pycil — backend environment variables
# Copy to `.env` (dev) or `.env.production` (prod) and fill in secrets.
# Consumed by apps/api (FastAPI), apps/worker (arq), and docker-compose.yml.
# =============================================================================

# --- General -----------------------------------------------------------------
DOMAIN=localhost
# CORS allow-list for the API (comma-separated). Also passed to Centrifugo.
ALLOWED_ORIGINS=http://localhost,https://localhost

# --- Postgres ----------------------------------------------------------------
POSTGRES_USER=pycil
POSTGRES_PASSWORD=changeme
POSTGRES_DB=pycil
# Sync URL (Alembic, backup service)
DATABASE_URL=postgresql://pycil:changeme@postgres:5432/pycil
DATABASE_URL_SYNC=postgresql://pycil:changeme@postgres:5432/pycil
# Async URL used by the FastAPI runtime + worker
DATABASE_URL_ASYNC=postgresql+asyncpg://pycil:changeme@postgres:5432/pycil

# --- Redis -------------------------------------------------------------------
REDIS_URL=redis://redis:6379/0

# --- lexi-ai (dictionary + question + grading authority) ---------------------
# Separate database from pycil's Postgres (two-DB boundary). SQLite by default;
# lives on the same node. Backup/restore must cover BOTH DBs to a consistent point.
LEXI_DB_URL=sqlite+aiosqlite:////data/lexi/lexi.db
# LLM for lexi generation/grading — OpenRouter (OpenAI-compatible).
LEXI_LLM_BASE_URL=https://openrouter.ai/api/v1
LEXI_LLM_API_KEY=
LEXI_LLM_MODEL=openai/gpt-4o-mini
# Read-only Cambridge SQLite source (~142MB, gitignored). Path INSIDE the
# container; the compose stack mounts it read-only (see LEXI_CAMBRIDGE_HOST_PATH).
# Without it, lexi search() returns empty and generation cannot resolve refs.
LEXI_CAMBRIDGE_DB_PATH=/data/cambridge
# Host path copied/mounted into api+worker as /data/cambridge. Defaults to the
# lexi-ai project data dir via the vendored symlink. Provision by copying from
# ~/projects/lexi-ai/data before `docker compose up`.
LEXI_CAMBRIDGE_HOST_PATH=./vendor/lexi-ai/data

# --- Centrifugo (realtime) ---------------------------------------------------
CENTRIFUGO_URL=http://centrifugo:8000
# Generate with: openssl rand -hex 32
CENTRIFUGO_API_KEY=changeme-centrifugo-api-key
# HMAC secret for connection tokens the api mints (user-scoped channels).
CENTRIFUGO_TOKEN_HMAC_SECRET=changeme-centrifugo-token-secret

# --- Auth (Google OAuth 2.1 + PKCE, handled entirely by apps/api) ------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Shared HS256 signing key the API uses to mint/verify session JWTs.
# Generate with: openssl rand -base64 32
AUTH_JWT_SECRET=changeme-base64-32-bytes
# Optional: set during rotation overlap so the API verifies tokens signed with the prior key.
AUTH_JWT_SECRET_PREVIOUS=
# Default 7d (604800s).
JWT_MAX_AGE_SECONDS=604800

# Shared secret for internal worker → api calls only.
# Generate with: openssl rand -base64 32
INTERNAL_API_SECRET=changeme-base64-32-bytes
# Internal docker-network URL the worker uses to reach the api.
PYCIL_API_INTERNAL_URL=http://api:8000

# --- Backup (restic → Backblaze B2) ------------------------------------------
RESTIC_REPOSITORY=
B2_ACCOUNT_ID=
B2_ACCOUNT_KEY=

# --- Caddy / TLS -------------------------------------------------------------
# Email used by Let's Encrypt for cert expiry notices (prod only)
CADDY_ACME_EMAIL=
