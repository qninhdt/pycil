# =============================================================================
# Pycil — backend environment variables
# Copy to `.env` (dev) or `.env.production` (prod) and fill in secrets.
# Consumed by apps/api (FastAPI), apps/worker (arq), and docker-compose.yml.
# =============================================================================

# --- General -----------------------------------------------------------------
DOMAIN=localhost
ENVIRONMENT=development
# Local-only API debugging bind. Leave unchanged in production; Caddy is the
# public TLS/WSS ingress on 80/443.
API_HOST_PORT=127.0.0.1:8000
# CORS allow-list for the API (comma-separated). Also passed to Centrifugo.
ALLOWED_ORIGINS=http://localhost,https://localhost

# --- Postgres ----------------------------------------------------------------
POSTGRES_USER=pycil
POSTGRES_PASSWORD=changeme
POSTGRES_DB=pycil
# Sync URL (Alembic, backup service)
DATABASE_URL=postgresql://pycil:changeme@postgres:5432/pycil
DATABASE_URL_SYNC=postgresql://pycil:changeme@postgres:5432/pycil
# Async URL used by the FastAPI runtime + worker
DATABASE_URL_ASYNC=postgresql+asyncpg://pycil:changeme@postgres:5432/pycil

# --- Redis -------------------------------------------------------------------
REDIS_PASSWORD=redis-dev-only
REDIS_URL=redis://:redis-dev-only@redis:6379/0

# --- Lexi service (dictionary + question + grading authority) ----------------
# Pycil never mounts Cambridge or Lexi's database. Both compose projects join
# the pre-created, internal Docker network `pycil-backend`.
LEXI_SERVICE_URL=http://lexi-service:8443
LEXI_SERVICE_INTERNAL_SERVICE_TOKEN=
# Must exactly match Lexi's verified Cambridge dataset SHA-256.
LEXI_REFERENCE_DATASET_SHA256=

# --- Assistant (OpenAI-compatible API; separate from lexi-ai) ---------------
# Any endpoint implementing OpenAI chat-completions is supported.
ASSISTANT_API_KEY=
ASSISTANT_MODEL=gpt-4o-mini
ASSISTANT_BASE_URL=
# Optional dedicated psycopg URL for LangGraph checkpoint persistence.
ASSISTANT_CHECKPOINT_DB_URL=
ASSISTANT_TIMEOUT_SECONDS=45
ASSISTANT_RUN_DEADLINE_SECONDS=120
ASSISTANT_MAX_OUTPUT_TOKENS=800
ASSISTANT_MAX_TOOL_CALLS=12
ASSISTANT_MAX_MESSAGE_CHARS=8000
ASSISTANT_PER_USER_CONCURRENCY=2
ASSISTANT_GLOBAL_CONCURRENCY=50
ASSISTANT_ACTION_TTL_SECONDS=900
ASSISTANT_RETENTION_DAYS=30
ASSISTANT_AUDIT_RETENTION_DAYS=90
ASSISTANT_MONTHLY_BUDGET_USD=0
ASSISTANT_ESTIMATED_COST_PER_1K_TOKENS_USD=0.01
ASSISTANT_REQUESTS_PER_MINUTE=30

# --- Centrifugo (realtime) ---------------------------------------------------
CENTRIFUGO_URL=http://centrifugo:8000
CENTRIFUGO_PUBLIC_WEBSOCKET_URL=wss://localhost/connection/websocket
# Generate with: openssl rand -hex 32
CENTRIFUGO_API_KEY=changeme-centrifugo-api-key
# HMAC secret for connection tokens the api mints (user-scoped channels).
CENTRIFUGO_TOKEN_HMAC_SECRET=changeme-centrifugo-token-secret

# --- Auth (Google OAuth 2.1 + PKCE, handled entirely by apps/api) ------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Exact BFF callback URLs, comma-separated. Required when ENVIRONMENT=production.
OAUTH_REDIRECT_URIS=http://localhost:3000/api/auth/callback
# Opt-in local-only CLI identity (`uv run python -m pycil.auth.dev_identity`).
# This is rejected when ENVIRONMENT=production.
DEV_IDENTITY_ENABLED=false
DEV_IDENTITY_EMAIL=dev@pycil.local
# Shared HS256 signing key the API uses to mint/verify session JWTs.
# Generate with: openssl rand -base64 32
AUTH_JWT_SECRET=changeme-base64-32-bytes
# Optional: set during rotation overlap so the API verifies tokens signed with the prior key.
AUTH_JWT_SECRET_PREVIOUS=
# Default 7d (604800s).
JWT_MAX_AGE_SECONDS=900
REFRESH_TOKEN_PEPPER=replace-with-a-random-32-byte-secret
REFRESH_TOKEN_TTL_SECONDS=2592000

# --- Durable word generation safety ---
WORD_GENERATION_REQUESTS_PER_HOUR=5
WORD_GENERATION_MAX_INFLIGHT_PER_USER=10
WORD_GENERATION_MAX_INFLIGHT_GLOBAL=500
WORD_GENERATION_DAILY_LIMIT=1000

# Shared secret for internal worker → api calls only.
# Generate with: openssl rand -base64 32
INTERNAL_API_SECRET=changeme-base64-32-bytes
# Internal docker-network URL the worker uses to reach the api.
PYCIL_API_INTERNAL_URL=http://api:8000

# --- Backup (restic → Backblaze B2) ------------------------------------------
RESTIC_REPOSITORY=
B2_ACCOUNT_ID=
B2_ACCOUNT_KEY=
