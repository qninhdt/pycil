# =============================================================================
# Pycil — backend environment variables
# Copy to `.env` (dev) or `.env.production` (prod) and fill in secrets.
# Consumed by apps/api (FastAPI), apps/worker (Taskiq), and docker-compose.yml.
# =============================================================================

# --- General -----------------------------------------------------------------
DOMAIN=localhost
ENVIRONMENT=development
# Local-only API debugging bind. Leave unchanged in production; Caddy is the
# public TLS/SSE ingress on 80/443.
API_HOST_PORT=127.0.0.1:8000
# HTTP only redirects to HTTPS. Set 8080 locally if port 80 is already used.
CADDY_HTTP_PORT=80
# HTTPS debugging bind. Production keeps the public 443 default.
CADDY_HTTPS_PORT=443
# CORS allow-list for the API (comma-separated).
ALLOWED_ORIGINS=http://localhost,https://localhost

# --- Postgres ----------------------------------------------------------------
POSTGRES_USER=pycil
POSTGRES_PASSWORD=changeme
POSTGRES_DB=pycil
# Sync URL (Alembic, backup service)
DATABASE_URL=postgresql://pycil:changeme@postgres:5432/pycil
DATABASE_URL_SYNC=postgresql://pycil:changeme@postgres:5432/pycil
# Async URL used by the FastAPI runtime + worker
DB_URL=postgresql+asyncpg://pycil:changeme@postgres:5432/pycil
# Optional container-only overrides. Leave blank to use the compose `postgres`
# and `redis` service hostnames; this lets host-run API commands use localhost.
PYCIL_DOCKER_DB_URL=

# --- Redis -------------------------------------------------------------------
REDIS_PASSWORD=redis-dev-only
REDIS_URL=redis://:redis-dev-only@redis:6379/0
PYCIL_DOCKER_REDIS_URL=
# Local-only debugging bind, like API_HOST_PORT above. Parameterised so a second
# compose project (scripts/rehearse-fresh-schema.sh) can run beside the live
# stack instead of colliding on a hardcoded host port.
REDIS_HOST_PORT=127.0.0.1:6379

# --- Embedded Lexi domain library ---------------------------------------------
# The domain uses the same PostgreSQL cluster, isolated in the `lexi` schema.
# The migration gate creates this fresh schema before Pycil's own migrations.
LEXI_DB_SCHEMA=lexi
LEXI_DOMAIN_MIGRATION_HEAD=20260806_01
# Lexi stores sense vectors outside its relational schema, behind an opt-in switch.
# `none` (default) keeps semantic search off: no extras, no volume, and a stray
# call raises instead of quietly returning no matches. `lancedb` needs Lexi's
# [embeddings] and [lancedb] extras plus a persistent LEXI_VECTOR_PATH mount.
LEXI_VECTOR_BACKEND=none
# SHA-256 identity persisted in content task work keys.
LEXI_REFERENCE_DATASET_FINGERPRINT=
# Immutable reference artifact mounted read-only into API and worker containers.
# This must be an absolute host path in deployment environments.
LEXI_REFERENCE_DATASET_PATH=
# Optional but strongly recommended for deployment rehearsal. The rehearsal
# refuses an artifact whose SHA-256 differs from this value.
LEXI_REFERENCE_DATASET_SHA256=
# Lexi provider configuration. The worker uses it for generation; the API uses
# the same provider only for synchronous rubric grading.
LEXI_LLM_BASE_URL=https://api.vilao.ai/v1
LEXI_LLM_API_KEY=
LEXI_LLM_MODEL=gemini-3.8-flash
LEXI_LLM_TEMPERATURE=0.1
# "json_schema" asks for a strict native schema, which is right on OpenAI itself.
# "function_calling" is the default here because it is the safe one against an
# OpenAI-compatible proxy, for two independent reasons:
#   - several proxies answer 200 with prose while silently ignoring a json_schema
#     response format, so generation fails on parsing rather than on a visible error;
#   - only this path strips `anyOf:[X, null]` from the schema before sending it.
#     A proxy that cannot handle a nullable union answers with an empty object, and
#     one nullable field is enough — `GeneratedSense` has eight.
# Switch to "json_schema" only against an endpoint verified to handle both.
LEXI_LLM_STRUCTURED_METHOD=function_calling
LEXI_LLM_REASONING_EFFORT=

# --- Assistant (OpenAI-compatible API; separate from Lexi) ------------------
# Any endpoint implementing OpenAI chat-completions is supported.
#
# Connection and credential only. The model, its reasoning effort, the turn
# timeout, the tool-call budget and the model catalog all live in the committed
# config/config.yaml, so changing one is a config edit rather than an
# environment change on every replica.
ASSISTANT_API_KEY=
ASSISTANT_BASE_URL=https://api.vilao.ai/v1
# Optional dedicated psycopg URL for LangGraph checkpoint persistence.
ASSISTANT_CHECKPOINT_DB_URL=
ASSISTANT_RUN_DEADLINE_SECONDS=120
ASSISTANT_MAX_MESSAGE_CHARS=8000
ASSISTANT_CONTEXT_WINDOW_TOKENS=8192
# Concurrent runs per learner are plan-scoped (Free 1, Pro 2); see account.plans.
ASSISTANT_RETENTION_DAYS=30

# --- Auth (Clerk) ------------------------------------------------------------
# Clerk issues and validates sessions. The API verifies the bearer token against
# Clerk's JWKS and maps the stable subject to an internal Pycil UUID, which every
# product foreign key keeps pointing at. There is no local signing secret, so
# nothing here can mint a credential.
#
# JWKS URL is required: without it the verifier refuses every request rather than
# falling back to a locally-signed token.
CLERK_JWKS_URL=https://your-instance.clerk.accounts.dev/.well-known/jwks.json
CLERK_ISSUER=https://your-instance.clerk.accounts.dev
# Optional: only set if tokens are minted with an audience claim.
CLERK_AUDIENCE=
# Required only for account deletion, which removes the external sign-in identity
# through Clerk's management API. Verification alone does not need it.
CLERK_SECRET_KEY=

# Shared secret for internal worker → api calls only.
# Generate with: openssl rand -base64 32
INTERNAL_API_SECRET=changeme-base64-32-bytes
# Internal docker-network URL the worker uses to reach the api.
PYCIL_API_INTERNAL_URL=http://api:8000

# --- Web app (apps/web) ------------------------------------------------------
# Caddy serves the app and API on this one origin; the browser uses the API's
# HttpOnly auth cookies and sends the CSRF cookie on unsafe requests.
# Local-only debugging bind, like API_HOST_PORT above.
WEB_HOST_PORT=127.0.0.1:3000

# --- Backup (restic → Backblaze B2) ------------------------------------------
RESTIC_REPOSITORY=
B2_ACCOUNT_ID=
B2_ACCOUNT_KEY=
