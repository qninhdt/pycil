# Addresses and credentials only. Product policy belongs to config/config.yaml.
# Fill required placeholders; never commit an actual .env or print Compose config.
DOMAIN=localhost
API_HOST_PORT=127.0.0.1:8000
CADDY_HTTP_PORT=80
CADDY_HTTPS_PORT=443
ALLOWED_ORIGINS=http://localhost,https://localhost

# Single source of address, database, username and password.
# Percent-encode special characters in URI credentials.
# scripts/compose.py derives store bootstrap credentials, loopback published ports
# and container DNS addresses; do not configure a second Docker URL.
DB_URL=postgresql+asyncpg://pycil:replace-with-random-secret@127.0.0.1:5434/pycil
REDIS_URL=redis://:replace-with-random-secret@127.0.0.1:6379/0

# All application and native checkpoint tables belong to public.
# Run explicit setup and JSONL reference import; content seeds are optional/manual.
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
# Instructor sends directly to this complete Decisions endpoint.
DECISION_BASE_URL=https://openrouter.ai/api/alpha/decisions
DECISION_API_KEY=

CLERK_JWKS_URL=https://your-instance.clerk.accounts.dev/.well-known/jwks.json
CLERK_ISSUER=https://your-instance.clerk.accounts.dev
CLERK_AUDIENCE=
CLERK_SECRET_KEY=
