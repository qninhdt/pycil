# =============================================================================
# Pycil — environment variables
# Copy to `.env` (dev) or `.env.production` (prod) and fill in secrets.
# =============================================================================

# --- General -----------------------------------------------------------------
NODE_ENV=development
DOMAIN=localhost
ALLOWED_ORIGINS=http://localhost,https://localhost

# --- Postgres ----------------------------------------------------------------
POSTGRES_USER=pycil
POSTGRES_PASSWORD=changeme
POSTGRES_DB=pycil
DATABASE_URL=postgresql://pycil:changeme@postgres:5432/pycil
# Async URL used by FastAPI runtime
DATABASE_URL_ASYNC=postgresql+asyncpg://pycil:changeme@postgres:5432/pycil

# --- Redis -------------------------------------------------------------------
REDIS_URL=redis://redis:6379/0

# --- Auth.js v5 (web) --------------------------------------------------------
# Generate with: openssl rand -base64 32
AUTH_SECRET=changeme-base64-32-bytes
# Dev default :3000. `make staging` runs host web on :3100 and exports
# AUTH_URL=http://localhost:3100 at launch, so this value need not change for it.
AUTH_URL=http://localhost:3000
AUTH_TRUST_HOST=true

# --- Generic OIDC provider (Dex locally, Google in prod) ---------------------
# Auth.js is a generic OIDC relying-party — the provider is built entirely from
# these vars, no provider name appears in code. Switching IdP is an env swap.
#
# LOCAL/STAGING (Dex): point at the Dex issuer the compose stack serves. Web
# runs on the host, so the browser and the Auth.js server both reach
# localhost:5556 with the SAME string (no browser/server issuer split).
OIDC_ISSUER_URL=http://localhost:5556/dex
OIDC_CLIENT_ID=pycil-web
# Placeholder — the real local value lives in `.env` (Dex config ships the
# working local secret; this example never points a prod copy at localhost).
OIDC_CLIENT_SECRET=changeme-dex-client-secret
OIDC_PROVIDER_ID=oidc
OIDC_PROVIDER_NAME=Dex
#
# PRODUCTION (Google) — swap the values above to these, change nothing else:
#   OIDC_ISSUER_URL=https://accounts.google.com
#   OIDC_CLIENT_ID=<google-oauth-client-id>.apps.googleusercontent.com
#   OIDC_CLIENT_SECRET=<google-oauth-client-secret>
#   OIDC_PROVIDER_NAME=Google
#   (OIDC_PROVIDER_ID stays "oidc" — it only names the callback path)

# Shared HS256 signing key (Auth.js JWS encode/decode + FastAPI verify).
# Generate with: openssl rand -base64 32
AUTH_JWT_SECRET=changeme-base64-32-bytes
# Optional: set during rotation overlap so FastAPI verifies tokens signed with the prior key.
AUTH_JWT_SECRET_PREVIOUS=
# Default 7d (604800s).
JWT_MAX_AGE_SECONDS=604800

# Separate from AUTH_JWT_SECRET — used by web → core /auth/upsert-user only.
# Generate with: openssl rand -base64 32
INTERNAL_API_SECRET=changeme-base64-32-bytes

# --- pycil-core (FastAPI) ----------------------------------------------------
# Cookie name lookup order: __Secure-pycil-session (prod) → pycil-session (dev)
SESSION_COOKIE_NAME=pycil-session
# Internal docker-network URL — used by anything in the compose stack that needs
# to call pycil-core directly (worker, future internal jobs). Web runs on Vercel
# and talks to pycil-core via the public Caddy domain.
PYCIL_CORE_INTERNAL_URL=http://pycil-core:8000
# Public API base. Web (on Vercel) hits Caddy at https://${DOMAIN}/api/core/*.
NEXT_PUBLIC_API_BASE=/api/core
# Dev-only: Next.js rewrites /api/core/* to this target when NODE_ENV=development.
NEXT_DEV_PROXY_TARGET=http://localhost:8000
# Frontend mock mode (dev/demo only). When "true", the web app runs entirely on
# in-browser mock data (localStorage-backed) with auth bypassed — no backend
# needed. Flip to "false" (or unset) to use the real pycil-core backend. MUST be
# "false" in production.
NEXT_PUBLIC_USE_MOCK=false

# --- worker / OpenRouter -----------------------------------------------------
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_MODEL_FALLBACKS=google/gemini-flash-1.5,anthropic/claude-haiku
OPENROUTER_BUDGET_DAILY_USD=20
# TTS via OpenRouter's OpenAI-compatible /audio/speech (reuses the key above —
# no separate TTS provider secret). Single voice for all languages (v1).
OPENROUTER_TTS_MODEL=openai/gpt-4o-mini-tts
OPENROUTER_TTS_VOICE=alloy

# --- Object storage (S3-compatible: avatars + TTS audio) ---------------------
# Local staging points these at the MinIO container in docker-compose.override.
# In prod, set them to your real S3 provider (e.g. Backblaze B2's S3 endpoint).
# Storage clients are plain boto3 S3 — switching provider is an env swap.
# NOTE: the restic *backup* service keeps its Backblaze-native B2_ACCOUNT_* vars
# (a different API); do not confuse those with these app-storage S3_* vars.
S3_BUCKET=pycil-media
S3_ENDPOINT=http://minio:9000
S3_KEY_ID=minioadmin
S3_APPLICATION_KEY=minioadmin
# Browser-facing GET host for stored objects (presigned URLs / public prefix).
S3_PUBLIC_URL_PREFIX=http://localhost:9000/pycil-media

# --- Caddy / TLS -------------------------------------------------------------
# Email used by Let's Encrypt for cert expiry notices (prod only)
CADDY_ACME_EMAIL=
