      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (task_name) (rate(task_wait_time_seconds_sum{env=\"$env\"}[5m])) / sum by (task_name) (rate(task_wait_time_seconds_count{env=\"$env\"}[5m]))",
          "legendFormat": "__auto",
          "range": true,
          "exemplar": false,
