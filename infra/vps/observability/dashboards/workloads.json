    {
      "id": 6,
      "title": "Memory store hit ratio",
      "description": "No activity produces no ratio; misses or LRU evictions alone do not page.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(sum by (service_name, store) (rate(pycil_store_requests_total{env=\"$env\",version=~\"$version\",outcome=\"hit\"}[5m])) or sum by (service_name, store) (rate(pycil_store_requests_total{env=\"$env\",version=~\"$version\"}[5m])) * 0) / sum by (service_name, store) (rate(pycil_store_requests_total{env=\"$env\",version=~\"$version\"}[5m]))",
          "legendFormat": "__auto",
          "range": true,
          "exemplar": false,
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "noValue": "No data",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 8
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 7,
      "title": "Memory store entries / capacity",
      "description": "Entries at last mutation can include later-expired items until another mutation; capacity is entries, not bytes.",
