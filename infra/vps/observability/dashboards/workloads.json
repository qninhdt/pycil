    {
      "id": 5,
      "title": "Native task errors",
      "description": "Counts native attempts, not unique user-visible jobs; do not infer terminal success from HTTP 202.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (task_name) (increase(task_errors_total{env=\"$env\"}[5m]))",
          "legendFormat": "__auto",
          "range": true,
          "exemplar": false,
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
