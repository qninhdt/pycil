          "refId": "A",
          "expr": "max by (index) (pycil_search_pending_age_seconds{env=\"$env\",version=~\"$version\"} and (timestamp(pycil_search_pending_age_seconds{env=\"$env\",version=~\"$version\"}) > time() - 60))",
