{
  "uid": "pycil-workloads",
  "title": "Pycil / Jobs, memory caches and Tantivy",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "tags": [
    "pycil",
    "vps",
    "private"
  ],
  "timezone": "utc",
  "refresh": "1m",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "env",
        "type": "custom",
        "query": "vps",
        "current": {
          "text": "vps",
          "value": "vps"
        },
        "options": [
          {
            "text": "vps",
            "value": "vps",
            "selected": true
          }
        ],
        "hide": 0
      },
      {
        "name": "version",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "definition": "label_values(pycil_store_capacity{env=\"$env\"}, version)",
        "query": {
          "query": "label_values(pycil_store_capacity{env=\"$env\"}, version)",
          "refId": "version"
        },
        "refresh": 1,
        "includeAll": true,
        "allValue": ".*",
        "multi": false,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "title": "Native worker active attempts",
      "description": "Absent before native middleware first records work is not an empty healthy queue.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (task_name) (worker_active_tasks{env=\"$env\"} and (timestamp(worker_active_tasks{env=\"$env\"}) > time() - 60))",
          "legendFormat": "__auto",
          "range": true,
          "exemplar": false,
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "No data",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 8
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 2,
      "title": "Redis group lag / pending",
      "description": "Lag = not yet delivered; pending includes running/unacknowledged attempts. ACKed retained history is neither.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "redis_stream_group_lag{env=\"$env\",stream=\"pycil:jobs:tasks\",group=\"pycil-workers\"}",
          "legendFormat": "__auto",
          "range": true,
          "exemplar": false,
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        },
        {
          "refId": "B",
          "expr": "redis_stream_group_messages_pending{env=\"$env\",stream=\"pycil:jobs:tasks\",group=\"pycil-workers\"}",
          "legendFormat": "__auto",
          "range": true,
          "exemplar": false,
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "No data",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 8
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 3,
      "title": "Native task queue wait (mean)",
      "description": "",
