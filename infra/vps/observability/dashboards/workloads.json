      "targets": [
        {
          "refId": "A",
          "expr": "sum by (service_name, store) (pycil_store_entries{env=\"$env\",version=~\"$version\"} and (timestamp(pycil_store_entries{env=\"$env\",version=~\"$version\"}) > time() - 60))",
          "legendFormat": "__auto",
          "range": true,
          "exemplar": false,
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        },
        {
          "refId": "B",
          "expr": "sum by (service_name, store) (pycil_store_capacity{env=\"$env\",version=~\"$version\"} and (timestamp(pycil_store_capacity{env=\"$env\",version=~\"$version\"}) > time() - 60))",
          "legendFormat": "__auto",
          "range": true,
          "exemplar": false,
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
