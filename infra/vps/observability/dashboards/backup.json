        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "pycil_backup_last_attempt_success{cluster=\"vps\"}",
          "legendFormat": "last success",
          "range": true,
          "exemplar": false,
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        },
        {
