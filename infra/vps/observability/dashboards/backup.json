{
  "uid": "pycil-backup",
  "title": "Pycil / PostgreSQL backups",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "tags": [
    "pycil",
    "vps",
    "private"
  ],
  "timezone": "utc",
  "refresh": "15s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "title": "Age of last successful full backup",
      "description": "Production VPS cluster. Missing telemetry requires investigation; a successful upload does not prove restore.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "time() - pycil_backup_last_success_timestamp_seconds{cluster=\"vps\"}",
          "legendFormat": "{{instance}}",
          "range": true,
          "exemplar": false,
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "noValue": "No data",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 8
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 2,
      "title": "Latest full backup success / running",
      "description": "Production VPS cluster. Missing telemetry requires investigation; a successful upload does not prove restore.",
      "type": "timeseries",
