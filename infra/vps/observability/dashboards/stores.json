      "targets": [
        {
          "refId": "A",
          "expr": "sum by (env) (rate(redis_commands_duration_seconds_total{env=\"$env\"}[5m])) / sum by (env) (rate(redis_commands_processed_total{env=\"$env\"}[5m]))",
