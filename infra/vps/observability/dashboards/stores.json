      "id": 1,
      "title": "PostgreSQL / Redis reachable",
      "description": "",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "pg_up{env=\"$env\"}",
          "legendFormat": "__auto",
          "range": true,
          "exemplar": false,
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        },
        {
          "refId": "B",
          "expr": "redis_up{env=\"$env\"}",
          "legendFormat": "__auto",
