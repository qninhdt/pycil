{
  "uid": "pycil-api",
  "title": "Pycil / API RED",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "tags": [
    "pycil",
    "vps",
    "private"
  ],
  "timezone": "utc",
  "refresh": "1m",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "env",
        "type": "custom",
        "query": "vps",
        "current": {
          "text": "vps",
          "value": "vps"
        },
        "options": [
          {
            "text": "vps",
            "value": "vps",
            "selected": true
          }
        ],
        "hide": 0
      },
      {
        "name": "version",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "definition": "label_values(pycil_store_capacity{env=\"$env\"}, version)",
        "query": {
          "query": "label_values(pycil_store_capacity{env=\"$env\"}, version)",
          "refId": "version"
        },
        "refresh": 1,
        "includeAll": true,
        "allValue": ".*",
        "multi": false,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "title": "Ordinary request rate by route/status",
      "description": "",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "pycil:http_requests:rate5m{env=\"$env\",version=~\"$version\"}",
          "legendFormat": "{{http_target}} {{http_status_code}}",
          "range": true,
          "exemplar": false,
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "noValue": "No data",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 8
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 2,
      "title": "Server error ratio (5m)",
      "description": "No traffic yields NaN/no data, not healthy 0%. Includes 4xx in eligible denominator; excludes probes, unmatched routes and assistant SSE.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "pycil:http_errors:ratio5m{env=\"$env\"}",
          "legendFormat": "__auto",
          "range": true,
          "exemplar": false,
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "noValue": "No data",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 8
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 3,
      "title": "Fleet HTTP p50 / p95 / p99",
      "description": "Aggregate buckets across processes before computing percentiles. Native HTTP histogram uses milliseconds.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.5, sum by (le) (pycil:http_duration_ms_bucket:rate5m{env=\"$env\",version=~\"$version\"})) / 1000",
          "legendFormat": "__auto",
          "range": true,
          "exemplar": false,
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le) (pycil:http_duration_ms_bucket:rate5m{env=\"$env\",version=~\"$version\"})) / 1000",
          "legendFormat": "__auto",
          "range": true,
          "exemplar": false,
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        },
        {
          "refId": "C",
          "expr": "histogram_quantile(0.99, sum by (le) (pycil:http_duration_ms_bucket:rate5m{env=\"$env\",version=~\"$version\"})) / 1000",
          "legendFormat": "__auto",
          "range": true,
          "exemplar": false,
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "noValue": "No data",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 8
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 4,
      "title": "HTTP latency buckets \u2192 trace exemplar",
      "description": "Cumulative observations by bucket; le bounds are milliseconds. Use a raw bucket exemplar to open Tempo; recording rules do not preserve exemplars.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "http_server_duration_milliseconds_bucket{env=\"$env\",version=~\"$version\",service_name=\"pycil-api\",http_target!~\"/livez|/readyz\"}",
          "legendFormat": "__auto",
          "range": true,
          "exemplar": true,
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "No data",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 8
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 5,
      "title": "Active HTTP requests",
      "description": "",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (service_name, http_method) (http_server_active_requests{env=\"$env\",version=~\"$version\"} and (timestamp(http_server_active_requests{env=\"$env\",version=~\"$version\"}) > time() - 60))",
          "legendFormat": "__auto",
          "range": true,
          "exemplar": false,
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "No data",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 8
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 6,
      "title": "DB pool acquisition p95",
      "description": "Includes queueing, opening and validation; separate from SQL execution.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, pool) (rate(pycil_db_pool_acquire_duration_seconds_bucket{env=\"$env\",version=~\"$version\"}[5m])))",
          "legendFormat": "__auto",
          "range": true,
          "exemplar": false,
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "noValue": "No data",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 8
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 7,
      "title": "SQL roundtrip p95",
      "description": "",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, pool) (rate(pycil_db_query_duration_seconds_bucket{env=\"$env\",version=~\"$version\"}[5m])))",
          "legendFormat": "__auto",
          "range": true,
          "exemplar": false,
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "noValue": "No data",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 8
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 8,
      "title": "Assistant stream terminal outcomes",
      "description": "Not inferred from initial HTTP 200; interrupted and cancelled remain distinct.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (outcome) (increase(pycil_operation_duration_seconds_count{env=\"$env\",version=~\"$version\",operation=\"assistant_stream\"}[5m]))",
          "legendFormat": "__auto",
          "range": true,
          "exemplar": false,
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "No data",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 8
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 9,
      "title": "HTTP request bytes/s",
      "description": "Optional until the API emits a request-body size observation.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(http_server_request_body_size_bytes_sum{env=\"$env\",version=~\"$version\"}[5m]))",
          "legendFormat": "__auto",
          "range": true,
          "exemplar": false,
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "Bps",
          "noValue": "No data",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 8
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 11,
      "type": "text",
      "title": "Measurement boundaries",
      "gridPos": {
        "x": 0,
        "y": 40,
        "w": 24,
        "h": 5
      },
      "options": {
        "mode": "markdown",
        "content": "SLI: eligible completed ordinary requests returning 5xx / all eligible completed ordinary requests over 5 minutes. Probes, unmatched routes and `/v1/assistant:run` are excluded. SSE uses terminal operation outcomes. The error ratio intentionally aggregates versions; route/rate/latency views can filter version. Paid provider requests and SSE require separate commissioning checks."
      }
    }
  ]
}
