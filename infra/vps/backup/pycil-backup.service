[Unit]
Description=Verified full PostgreSQL backup to S3
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target
StartLimitIntervalSec=24h
StartLimitBurst=3

[Service]
Type=oneshot
WorkingDirectory=/opt/pycil
ExecStart=/usr/bin/python3 scripts/compose.py --env-file /etc/pycil/runtime.env --project-name pycil-production --file infra/vps/compose.yaml run --rm --no-deps --name pycil-full-backup backup
# Remove only this service's utility if Compose exits before the container.
ExecStopPost=-/usr/bin/docker rm -f pycil-full-backup
TimeoutStartSec=60min
TimeoutStopSec=60s
Restart=on-failure
RestartSec=10min
