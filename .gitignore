# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# testing
/coverage
.coverage
**/.coverage

# agent / tooling scratch
.agents/
.agent
.codegraph/
.codex/
logs/

/out/
dist/
bin/

# production
/build

# misc
.DS_Store
*.pem

# CK tooling artifact — generated, not app code; must not be committed
release-manifest.json

# debug
npm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

repomix-output.xml
.serena/cache
plans/**/*
!plans/templates/*
screenshots/*
docs/screenshots/*

# Plan-scoped review artifacts must stay committable: the plan body itself is
# scratch, but reports and the screenshots they cite are evidence for the work.
# `!plans/*/` only reopens the plan directories so git descends into them; the
# plan markdown underneath is still matched by `plans/**/*`.
!plans/*/
!plans/*/reports/
!plans/*/reports/**
logs.txt
test-ck
__pycache__
*.egg-info/

# CK meta commands
prompt.md
ck.md

# Generated runtime layout for release/install smoke tests
/.claude/
# But track repo-level rules that Claude Code reads
!/.claude/rules/

# Local-only state inside tracked claude source
claude/agent-memory/
claude/hooks/.logs/
claude/session-state/latest.md
claude/session-state/archive/
claude/settings.bak.json
claude/skills/ai-multimodal/assets/demo-*.claude/session-state/*.tmp

# Gemini CLI settings (symlink to staged .claude/.mcp.json)
.gemini/settings.json
# Showoff/marketing assets (images, showcases)
assets/
# Exception: use-mcp ships a persistent tool catalog at assets/tools.json
!claude/skills/use-mcp/assets/
!claude/skills/use-mcp/assets/**

# External repos for study/reference
external/

.kiro

# lexi-ai editable path dep — symlinked/copied into the build context locally;
# in CI/deploy the source is provided out-of-band (interim until PyPI publish).
vendor/

# Git worktrees (local development only)
worktrees/

# Database backups. These contain real user emails, so a stray `git add -A` must
# never be able to stage one. Prefer writing dumps outside the tree entirely
# (`/tmp`); this is the backstop for when a tool insists on the repo root.
*.dump
*.sql.gz
backup-manifest-*.json

# Node.js
node_modules/
.pnpm-debug.log*
