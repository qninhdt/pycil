# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
# Playwright run artifacts. Traces and DOM snapshots embed sealed session
# cookies and internal proxy headers, so they must never reach the remote.
/playwright-report/
/test-results/
/blob-report/
/playwright/.cache/
# The signed-in storage state and the seeded fixture, written by global setup.
# `state.json` holds a live `pycil-session` cookie — an actual credential, not a
# placeholder — and `fixture.json` names run-scoped ids. Both are rebuilt by every
# run, so there is nothing to preserve and everything to leak.
/tests/e2e/.auth/
# The screenshot working directory. The reviewed set is committed under the
# plan's reports/ instead — keeping both would mean two copies drifting apart,
# and this one is overwritten by every capture run.
/tests/screenshots/captured/

# next.js
/.next/
/out/

# storybook build output
/storybook-static/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# typescript
*.tsbuildinfo
next-env.d.ts
