# iron-session encryption password. At least 32 bytes, and required: the app
# refuses to boot without it rather than falling back to a shared literal.
# Generate one with:  openssl rand -base64 32
SESSION_PASSWORD=replace-with-a-random-32-byte-secret-password
SESSION_COOKIE_NAME=pycil_session

# Backend API URL (server-side only, never exposed to browser)
PYCIL_API_URL=http://localhost:8000

# OAuth callback URL / Public app URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
