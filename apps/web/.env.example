# Public Clerk key; use the same Clerk instance as the API.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
# The frontend calls this backend directly under /v1/*.
PYCIL_API_URL=http://127.0.0.1:8000
# mock = bundled JSON, no Clerk/backend; live (default) = real services.
NEXT_PUBLIC_DATA_MODE=live

# Canonical frontend origin for public metadata and share links.
NEXT_PUBLIC_SITE_URL=https://pycil.qninhdt.com
